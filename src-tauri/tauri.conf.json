{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gesture Tracker",
  "version": "1.0.0",
  "identifier": "com.aroo.gesturetracker",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Body Deck — Gesture Tracker",
        "width": 1100,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "./Info.plist"
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gesture Tracker",
  "version": "1.0.0",
  "identifier": "com.aroo.gesturetracker",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "",
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Body Deck — Gesture Tracker",
        "width": 1100,
        "height": 900,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera feed stays on this Mac — used for on-device hand, face and pose tracking.",
        "NSMicrophoneUsageDescription": "The microphone is used for local voice commands and reminders. Audio never leaves this Mac."
      }
    }
  }
}
